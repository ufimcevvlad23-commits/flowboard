APP_ENV=development
DATABASE_URL=sqlite:///./seo_mvp.db

# OpenAI-compatible LLM. Without a key, article generation uses a mock response.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Optional SEO providers. Without them, keyword metrics are deterministic mock data.
KEYS_SO_API_KEY=
ARSENKIN_API_KEY=

# Optional operational settings
EXTERNAL_API_TIMEOUT=20
KEYS_SO_DATABASE=msk
